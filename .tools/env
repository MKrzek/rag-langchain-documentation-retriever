#!/bin/sh
# add binaries to PATH if they aren't added yet
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
    *:"$HOME/Desktop/dev-projects/rag-langchain-documentation-retriever/.tools":*)
        ;;
    *)
        # Prepending path in case a system-installed binary needs to be overridden
        export PATH="$HOME/Desktop/dev-projects/rag-langchain-documentation-retriever/.tools:$PATH"
        ;;
esac
